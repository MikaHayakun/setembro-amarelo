{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "python3 Projeto_Setembro_Amarelo_2026_Codigo/projeto-setembro-amarelo/scripts/build_public_site.py",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/health", "destination": "/data/health.json" },
    { "source": "/api/campaigns", "destination": "/data/campaigns.json" },
    { "source": "/api/campaigns/:month", "destination": "/data/campaigns/:month.json" },
    { "source": "/api/sources", "destination": "/data/sources.json" }
  ]
}
